# Ambiente local (nunca coloque segredos reais aqui)
NODE_ENV=development

# Banco de dados (PostgreSQL)
POSTGRES_USER=margem
POSTGRES_PASSWORD=margem_dev
POSTGRES_DB=margem
DATABASE_URL=postgresql://margem:margem_dev@localhost:5432/margem?schema=public

# Redis
REDIS_PASSWORD=margem_redis_dev
REDIS_URL=redis://:margem_redis_dev@localhost:6379

# E-mail local (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Margem <no-reply@margem.local>

# URLs locais
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Observabilidade
SENTRY_DSN=
APP_VERSION=0.0.0
NEXT_PUBLIC_SENTRY_DSN=

# Só produção (VPS, SMTP autenticado, sessão, logs e backup)
APP_DOMAIN=
SMTP_USER=
SMTP_PASSWORD=
SESSION_TTL_DAYS=14
LOG_LEVEL=info
BACKUP_AGE_RECIPIENT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-saopaulo-1
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_REQUEST_CHECKSUM_CALCULATION=
AWS_RESPONSE_CHECKSUM_VALIDATION=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=