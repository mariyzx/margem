# Ambiente local (nunca coloque segredos reais aqui)
NODE_ENV=development

# Banco de dados (PostgreSQL)
POSTGRES_USER=margem
POSTGRES_PASSWORD=margem_dev
POSTGRES_DB=margem
DATABASE_URL=postgresql://margem:margem_dev@localhost:5432/margem?schema=public

# Redis
REDIS_PASSWORD=margem_redis_dev
REDIS_URL=redis://:margem_redis_dev@localhost:6379

# E-mail local (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Margem <no-reply@margem.local>

# URLs locais
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Observabilidade
SENTRY_DSN=
APP_VERSION=0.0.0
NEXT_PUBLIC_SENTRY_DSN=

# Só produção (VPS, SMTP autenticado, sessão, logs e backup)
APP_DOMAIN=
SMTP_USER=
SMTP_PASSWORD=
SESSION_TTL_DAYS=14
# Teto global de e-mails de link mágico por dia (UTC)
MAGIC_LINK_DAILY_CAP=300
# Sessões ativas por usuário (a mais antiga é revogada ao passar do limite)
MAX_ACTIVE_SESSIONS_PER_USER=10
# Tetos por usuário (acima disso a API responde 422 quota_exceeded)
MAX_NOTEBOOKS_PER_USER=100
MAX_NOTES_PER_USER=5000
MAX_SOURCES_PER_USER=500
MAX_SOURCE_STORAGE_MB_PER_USER=500
MAX_QUESTIONS_PER_USER=10000
# Keep-alive do servidor do Next em produção (ms); maior que o keepalive do Caddy (60s)
WEB_KEEP_ALIVE_TIMEOUT=65000
# Chave do HMAC de ipHash/emailHash (obrigatória em produção, mínimo 32 caracteres).
# Gere com: openssl rand -hex 32
LOG_HASH_SECRET=
# Dias de retenção do AuditLog (LGPD)
AUDIT_RETENTION_DAYS=90
LOG_LEVEL=info
BACKUP_AGE_RECIPIENT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-saopaulo-1
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
# Uploads de PDF: bucket próprio, obrigatório (sem ele o upload responde 503; nunca
# cai no bucket de backup). Usa as mesmas credenciais AWS_* de cima.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=margem-uploads
AWS_REQUEST_CHECKSUM_CALCULATION=
AWS_RESPONSE_CHECKSUM_VALIDATION=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=