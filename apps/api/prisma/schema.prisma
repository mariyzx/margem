generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  deletedAt DateTime? @map("deleted_date")
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  notebooks     Notebook[]
  notes         Note[]
  questions     Question[]
  reviewItems   ReviewItem[]
  authAccounts  AuthAccount[]
}

enum NotebookColor {
  bic
  correct
  turma
  marker
  ink
}

model Notebook {
  id        String        @id @default(cuid())
  ownerId   String
  name      String
  color     NotebookColor @default(bic)
  deletedAt DateTime?     @map("deleted_date")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notes   Note[]
  sources Source[]

  @@index([ownerId, deletedAt, updatedAt])
}

model Note {
  id               String    @id @default(cuid())
  notebookId       String
  authorId         String
  title            String    @default("")
  doc              Json
  materialOpenedAt DateTime?
  sourceId         String?
  deletedAt        DateTime? @map("deleted_date")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  notebook  Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  anchors   Anchor[]
  clozes    Cloze[]
  questions Question[]
  source    Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([notebookId, deletedAt, updatedAt])
  @@index([authorId, deletedAt, updatedAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

enum AnchorStatus {
  active
  orphaned
}

enum QuestionAuthorType {
  self
  group
  ai
}

enum QuestionStatus {
  pending
  approved
  discarded
}

model Anchor {
  id        String       @id @default(cuid())
  noteId    String?
  blockId   String
  quote     String
  prefix    String       @default("")
  suffix    String       @default("")
  status    AnchorStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?    @map("deleted_date")

  note      Note?      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  clozes    Cloze[]
  questions Question[]

  @@index([noteId, deletedAt])
}

model Cloze {
  id        String    @id @default(cuid())
  noteId    String
  anchorId  String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_date")

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  anchor Anchor @relation(fields: [anchorId], references: [id], onDelete: Cascade)

  @@index([noteId, deletedAt])
}

model Question {
  id         String             @id @default(cuid())
  noteId     String
  anchorId   String?
  authorType QuestionAuthorType @default(self)
  authorId   String?
  text       String
  answer     String
  status     QuestionStatus     @default(approved)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?          @map("deleted_date")

  note   Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  anchor Anchor? @relation(fields: [anchorId], references: [id], onDelete: SetNull)
  author User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([noteId, deletedAt, createdAt])
}

enum ReviewKind {
  cloze
  question
  practice
  link
}

enum ReviewRating {
  again
  hard
  easy
}

model ReviewItem {
  id            String       @id @default(cuid())
  userId        String
  kind          ReviewKind
  refId         String
  due           DateTime
  stability     Float        @default(0)
  difficulty    Float        @default(0)
  scheduledDays Int          @default(0)
  learningSteps Int          @default(0)
  reps          Int          @default(0)
  lapses        Int          @default(0)
  state         Int          @default(0)
  lastReview    DateTime?
  archivedAt    DateTime?
  deletedAt     DateTime?    @map("deleted_date")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs ReviewLog[]

  @@unique([userId, kind, refId])
  @@index([userId, archivedAt, deletedAt, due])
}

model ReviewLog {
  id            String       @id @default(cuid())
  reviewItemId  String
  rating        ReviewRating
  reviewedAt    DateTime     @default(now())
  previousState Json

  reviewItem ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)

  @@index([reviewItemId, reviewedAt])
}

enum SourceType {
  file
  link
  text
}

enum SourceStatus {
  queued
  processing
  ready
  failed
}

model Source {
  id            String       @id @default(cuid())
  notebookId    String
  type          SourceType
  title         String
  content       String?
  storageKey    String?
  url           String?
  status        SourceStatus @default(ready)
  failureReason String?
  deletedAt     DateTime?    @map("deleted_date")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  notes    Note[]
  chunks   SourceChunk[]

  @@index([notebookId, deletedAt, updatedAt])
}

model SourceChunk {
  id        String   @id @default(cuid())
  sourceId  String
  ord       Int
  text      String
  page      Int?
  startSec  Int?
  endSec    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, ord])
  @@index([sourceId])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId             String
  provider           String
  providerAccountId  String
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}