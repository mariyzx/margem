{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$APP_DOMAIN:localhost} {
	encode gzip zstd

	# Access log in JSON on stdout (Docker keeps it, capped by the compose `logging`).
	# Pseudonymized like the API logs: masked IPs, no credentials, no tokens in the URI.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 64
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 64
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				# Magic link token and the Google callback code/state.
				request>uri query {
					delete token
					delete code
					delete state
				}
			}
		}
	}

	# 1 MB for everything except the PDF upload, whose cap follows MAX_PDF_BYTES (25 MB,
	# apps/api/src/sources/pdf-validation.ts) plus room for the multipart envelope. The
	# matchers are disjoint so exactly one limit applies to each request.
	@pdfUpload path /api/sources/file
	@notPdfUpload not path /api/sources/file
	request_body @notPdfUpload {
		max_size 1MB
	}
	request_body @pdfUpload {
		max_size 26MB
	}

	# Permanent IP blocks, kept only on the VPS (*.caddy is gitignored; see
	# infra/caddy/blocklist/README.md). Each file defines a `handle` with `abort`, which
	# joins the handle blocks below and runs before the catch-all one.
	import blocklist/*.caddy

	handle_path /api/* {
		reverse_proxy api:3001 {
			# Below the API's keepAliveTimeout (65s): Caddy closes idle upstream
			# sockets first, so it never reuses one Node already closed (502).
			transport http {
				keepalive 60s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			# Below the web's KEEP_ALIVE_TIMEOUT (65s, see docker-compose.prod.yml).
			transport http {
				keepalive 60s
			}
		}
	}
}
